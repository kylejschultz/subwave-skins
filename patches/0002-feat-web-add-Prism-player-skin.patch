+    linear-gradient(90deg, color-mix(in oklab, var(--ink) 1.6%, transparent) 1px, transparent 1px),
+    var(--bg);
+  background-size: 38px 38px, 38px 38px, auto;
+}
+
+.background {
+  background:
+    radial-gradient(circle at 22% 16%, var(--prism-wash-a), transparent 30rem),
+    radial-gradient(circle at 82% 8%, var(--prism-wash-b), transparent 28rem),
+    linear-gradient(110deg, color-mix(in oklab, var(--bg) 94%, transparent), color-mix(in oklab, var(--bg) 78%, transparent) 56%, color-mix(in oklab, var(--bg) 90%, transparent));
+}
+
+.stageScrim {
+  background:
+    linear-gradient(90deg, color-mix(in oklab, var(--bg) 34%, transparent), color-mix(in oklab, var(--bg) 84%, transparent) 50%, color-mix(in oklab, var(--bg) 66%, transparent)),
+    radial-gradient(circle at 62% 48%, color-mix(in oklab, var(--accent) 7%, transparent), transparent 32rem);
+}
+
+.glass {
+  background:
+    linear-gradient(180deg, color-mix(in oklab, var(--surface) 46%, transparent), color-mix(in oklab, var(--bg) 26%, transparent)),
+    linear-gradient(110deg, color-mix(in oklab, var(--accent) 9%, transparent), transparent 62%);

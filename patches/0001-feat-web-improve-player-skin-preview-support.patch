diff --git a/web/components/player/StationTuner.tsx b/web/components/player/StationTuner.tsx
new file mode 100644
index 0000000..71f6cf7
--- /dev/null
+++ b/web/components/player/StationTuner.tsx
@@ -0,0 +1,169 @@
+'use client';
+
+import {
+  createContext,
+  useCallback,
+  useContext,
+  useEffect,
+  useMemo,
+  useState,
+  type ReactNode,
+} from 'react';
+import {
+  DEFAULT_STATION_ORIGIN,
+  originForStation,
+  type StationOrigin,
+} from '@/lib/stationOrigin';
+
+const STORAGE_KEY = 'subwave.stationOverride.v1';
+const CUSTOM_STATIONS_KEY = 'subwave.customStations.v1';
+
+export interface TunerStation {
+  slug: string;
+  name: string;
+  url: string;
+  location?: string;
+  genre?: string;
+  isLocal?: boolean;
+}
+
+interface StationTunerContextValue {
+  active: TunerStation;
+  stations: TunerStation[];
+  loading: boolean;
+  origin: StationOrigin;
+  addCustomStation: (input: string) => TunerStation | null;
+  setStation: (slug: string) => void;
+}
+
+const LOCAL_STATION: TunerStation = {
+  slug: '__local',
+  name: 'This station',
+  url: '',
+  isLocal: true,
+};
+
+const StationTunerContext = createContext<StationTunerContextValue | null>(null);
+
+function cleanStation(data: Record<string, unknown>): TunerStation | null {
+  const name = String(data.name ?? '').trim();
+  const url = String(data.url ?? '').trim();
+  const slug = String(data.slug ?? '').trim();
+  if (!name || !url || !slug) return null;
+  return {
+    slug,
+    name,
+    url,
+    ...(data.location ? { location: String(data.location) } : {}),
+    ...(data.genre ? { genre: String(data.genre) } : {}),
+  };
+}
+
+function stationFromUrl(input: string): TunerStation | null {
+  try {
+    const url = new URL(input.match(/^https?:\/\//i) ? input : `https://${input}`);
+    const origin = url.origin;
+    const host = url.host.replace(/^www\./, '');
+    return {
+      slug: `custom-${host.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`,
+      name: host,
+      url: origin,
+      location: 'Saved station',
+    };
+  } catch {
+    return null;
+  }
+}
+
+function loadCustomStations(): TunerStation[] {
+  if (typeof window === 'undefined') return [];
+  try {
+    const data: unknown = JSON.parse(window.localStorage.getItem(CUSTOM_STATIONS_KEY) || '[]');
+    if (!Array.isArray(data)) return [];
+    return data
+      .map(item => cleanStation((item ?? {}) as Record<string, unknown>))
+      .filter((item): item is TunerStation => item != null);
+  } catch {
+    return [];
+  }
+}
+
+function saveCustomStations(stations: TunerStation[]) {
+  window.localStorage.setItem(CUSTOM_STATIONS_KEY, JSON.stringify(stations));
+}
+
+function loadSavedSlug(): string {
+  if (typeof window === 'undefined') return LOCAL_STATION.slug;
+  return window.localStorage.getItem(STORAGE_KEY) || LOCAL_STATION.slug;
+}
+
+export function StationTunerProvider({ children }: { children: ReactNode }) {
+  const [stations, setStations] = useState<TunerStation[]>([LOCAL_STATION]);
+  const [activeSlug, setActiveSlug] = useState(LOCAL_STATION.slug);
+  const [loading, setLoading] = useState(true);
+
+  useEffect(() => {
+    setActiveSlug(loadSavedSlug());
+    const custom = loadCustomStations();
+    if (custom.length > 0) setStations([LOCAL_STATION, ...custom]);
+    let alive = true;
+    void (async () => {
+      try {
+        const res = await fetch('/stations.json', { cache: 'force-cache' });
+        if (!res.ok) return;
+        const data: unknown = await res.json();
+        if (!Array.isArray(data)) return;
+        const remote = data
+          .map((item) => cleanStation((item ?? {}) as Record<string, unknown>))
+          .filter((item): item is TunerStation => item != null);
+        if (alive) setStations([LOCAL_STATION, ...custom, ...remote.filter(r => !custom.some(c => c.url === r.url))]);
+      } finally {
+        if (alive) setLoading(false);
+      }
+    })();
+    return () => {
+      alive = false;
+    };
+  }, []);
+
+  const active = stations.find(station => station.slug === activeSlug) ?? LOCAL_STATION;
+  const origin = active.isLocal ? DEFAULT_STATION_ORIGIN : originForStation(active.url);
+  const setStation = useCallback((slug: string) => {
+    const next = slug || LOCAL_STATION.slug;
+    setActiveSlug(next);
+    window.localStorage.setItem(STORAGE_KEY, next);
+  }, []);
+  const addCustomStation = useCallback((input: string) => {
+    const station = stationFromUrl(input);
+    if (!station) return null;
+    const existing = stations.find(s => s.url === station.url);
+    if (existing) {
+      setActiveSlug(existing.slug);
+      window.localStorage.setItem(STORAGE_KEY, existing.slug);
+      return existing;
+    }
+    setStations(prev => {
+      const next = [LOCAL_STATION, station, ...prev.filter(s => !s.isLocal)];
+      saveCustomStations(next.filter(s => !s.isLocal && s.slug.startsWith('custom-')));
+      return next;
+    });
+    setActiveSlug(station.slug);
+    window.localStorage.setItem(STORAGE_KEY, station.slug);
+    return station;
+  }, [stations]);
+
+  const value = useMemo<StationTunerContextValue>(
+    () => ({ active, stations, loading, origin, addCustomStation, setStation }),
+    [active, stations, loading, origin, addCustomStation, setStation],
+  );
+
+  return (
+    <StationTunerContext.Provider value={value}>
+      {children}
+    </StationTunerContext.Provider>
+  );
+}
+
+export function useStationTuner(): StationTunerContextValue | null {
+  return useContext(StationTunerContext);
+}
